# Copy this file to .env.local and fill in the two values below.
# expo-eas-eval reads .env, then .env.local from the current directory.
# Exported environment variables take precedence over both files.
# Local simulator calibration does not need these values.

# Expo access token with access to the evaluation project's EAS workflows.
# Create at https://expo.dev/settings/access-tokens
EXPO_TOKEN=

# Existing EAS evaluation project UUID (not its name or slug).
# Find in the project's Expo dashboard settings, or extra.eas.projectId
# in an already linked app's app.json.
EAS_EVAL_PROJECT_ID=

# Uses EAS directly. No Expo Sandbox MCP or E2B credentials are needed.
# Model-provider credentials are separate; calibration uses scripted agents.
